{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/index?__campusdesk_path=/" },
    { "source": "/:path*", "destination": "/api/index?__campusdesk_path=/:path*" }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{*.py,static/**}"
    }
  }
}
